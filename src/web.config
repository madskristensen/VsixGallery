<?xml version="1.0" encoding="utf-8"?>
<!--
  This file is no longer used by IIS to configure the server. Its IIS-only
  settings (security, headers, staticContent, httpCompression) have been moved
  into Program.cs/Startup.cs so they work on both Kestrel (Linux) and IIS.

  It is kept only because Startup.cs reads the <rewrite> section at startup
  via RewriteOptions.AddIISUrlRewrite(), which is the cross-platform way to
  reuse IIS URL Rewrite rules on Kestrel.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Redirects to www.vsixgallery.com" patternSyntax="ECMAScript" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTP_HOST}" pattern="^(vsixgallery.com)+" />
          </conditions>
          <action type="Redirect" url="https://www.vsixgallery.com/{R:0}" appendQueryString="true" redirectType="Permanent" />
        </rule>

        <rule name="VSIX paths">
          <match url="^(.+)/(.+\.vsix)$" />
          <action type="Rewrite" url="{R:1}/extension.vsix" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>