@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment _env
@inject VsixGallery.PublicUrl _publicUrl
<!DOCTYPE html>
<html lang="en">
<head prefix="og: http://ogp.me/ns#">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    @{
        string siteName = ViewData["SiteName"]?.ToString() ?? "Open VSIX Gallery";
        string pageTitle = ViewData["Title"]?.ToString() ?? siteName;
        string documentTitle = string.Equals(pageTitle, siteName, StringComparison.Ordinal)
            ? siteName
            : $"{pageTitle} | {siteName}";
    }
    <title>@documentTitle</title>
    <meta name="description" content="@(ViewData["Description"] ?? "An alternative Visual Studio extension gallery for nightly builds.")" />
    @{
        string publicOrigin = _publicUrl.GetOrigin(Context.Request);
        string canonicalPath = ViewData["CanonicalPath"] as string ?? Context.Request.Path;
        string canonicalUrl = publicOrigin + canonicalPath;
    }
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    @if (ViewData["SuppressCanonical"] is not true)
    {
        <link rel="canonical" href="@canonicalUrl" />
    }
    @if (ViewData["Robots"] is string robots)
    {
        <meta name="robots" content="@robots" />
    }

    <link rel="apple-touch-icon" href="~/img/icon-180x180.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/img/icon-32x32.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/img/icon-16x16.png" asp-append-version="true" />
    <link rel="manifest" href="/site.webmanifest?v=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111827" media="(prefers-color-scheme: dark)" />

    @{
        string feedUrl = ViewData["FeedUrl"] as string ?? "/feed/";
        string feedTitle = ViewData["FeedTitle"] as string ?? "Gallery feed";
        string? pageDescription = ViewData["Description"]?.ToString();
        string socialTitle = documentTitle;
        string socialDescription = pageDescription ?? "An alternative Visual Studio extension gallery for nightly builds.";
        string twitterCard = ViewData["TwitterCard"] as string ?? "summary_large_image";
        string socialImagePath = ViewData["Image"] as string ?? "/social/default.png";
        int socialImageWidth = ViewData["ImageWidth"] is int w ? w : VsixGallery.SocialCardRenderer.Width;
        int socialImageHeight = ViewData["ImageHeight"] is int h ? h : VsixGallery.SocialCardRenderer.Height;
        string absoluteImage = $"{publicOrigin}{socialImagePath}";
    }
    <link rel="alternate" type="application/atom+xml" title="@feedTitle" href="@feedUrl" />

    <meta name="twitter:card" content="@twitterCard" />
    <meta name="twitter:site" content="@@mkristensen" />
    <meta name="twitter:creator" content="@@mkristensen" />
    <meta name="twitter:title" content="@socialTitle" />
    <meta name="twitter:description" content="@socialDescription" />
    <meta name="twitter:image" content="@absoluteImage" />

    <meta property="og:title" content="@socialTitle" />
    <meta property="og:description" content="@socialDescription" />
    <meta property="og:site_name" content="@(ViewData["SiteName"] ?? "VSIX Gallery")" />
    <meta property="og:image:alt" content="@pageTitle" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="@absoluteImage" />
    <meta property="og:image:secure_url" content="@absoluteImage" />
    <meta property="og:image:width" content="@socialImageWidth" />
    <meta property="og:image:height" content="@socialImageHeight" />

    @{
        const string clarityBootstrap = "window.clarity=window.clarity||function(){(window.clarity.q=window.clarity.q||[]).push(arguments)};";
        ViewContext.HttpContext.AddInlineScriptHash(clarityBootstrap);
    }
    <script>@Html.Raw(clarityBootstrap)</script>
    <script async src="https://www.clarity.ms/tag/yigw7yp0j4"></script>
</head>
<body>
    @{
        string searchTerm = Context.Request.Path.StartsWithSegments("/search")
            ? Context.Request.Query["q"].ToString()
            : string.Empty;
    }
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header>
        <div class="container header-content">
            <a href="/" class="logo">
                <img src="~/img/logo.svg" alt="" width="30" height="30" />
                <span>@ViewData["SiteName"]</span>
            </a>

            <nav aria-label="Primary">
                @if (ViewData["HideSetupLink"] is not true) {
                    <a href="~/feedguide">Setup Feed</a>
                }
                @if (ViewData["HideUploadGuideLink"] is not true) {
                    <a href="~/devguide">Add Extension</a>
                }
            </nav>

            <div class="header-actions">
                <form action="~/search/" method="get" role="search">
                    <label for="search">Search</label>
                    <input type="search" id="search" value="@searchTerm" name="q" placeholder="Search extensions..." required />
                    <button type="submit">Search</button>
                </form>
            </div>

            <button type="button"
                    class="hamburger-btn"
                    aria-label="Menu"
                    aria-expanded="false"
                    aria-controls="mobile-menu">
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
            </button>

            <div id="mobile-menu" class="mobile-menu" hidden>
                <form action="~/search/" method="get" class="mobile-search" role="search">
                    <label for="mobile-search">Search</label>
                    <input type="search" id="mobile-search" value="@searchTerm" name="q" placeholder="Search extensions..." required size="20" />
                    <button type="submit">Search</button>
                </form>
                <nav aria-label="Mobile">
                    <a href="@(ViewData["FeedUrl"] as string ?? "/feed/")">Gallery Feed</a>
                    @if (ViewData["HideSetupLink"] is not true) {
                        <a href="~/feedguide">Setup Feed</a>
                    }
                    @if (ViewData["HideUploadGuideLink"] is not true) {
                        <a href="~/devguide">Add Extension</a>
                    }
                </nav>
            </div>
        </div>
    </header>
    <div class="mobile-menu-overlay" aria-hidden="true"></div>

    <main id="main-content" tabindex="-1">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer>
        <div class="container">
            <p id="copyright">
                &copy; @DateTime.Now.Year <a href="https://www.madskristensen.net" rel="noopener noreferrer">Mads Kristensen</a>
                <span class="separator" aria-hidden="true">•</span>
                <a href="https://github.com/madskristensen/VsixGallery/" rel="noopener noreferrer">Source on GitHub</a>
            </p>
        </div>
    </footer>

    <div id="site-status" class="sr-only" role="status" aria-live="polite"></div>

    @{
        string inlineJs = VsixGallery.JsHelper.GetMinified(_env, "js/site.js");
    }
    <script>@Html.Raw(inlineJs)</script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
