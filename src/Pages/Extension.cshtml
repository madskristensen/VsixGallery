@page "{id?}"
@model ExtensionModel
@using System.Text.Json;
@using VsixGallery;

@{
    ViewData["Title"] = Model.Package!.Name;
    var _desc = Model.Package.Description ?? string.Empty;
    ViewData["Description"] = _desc[..Math.Min(_desc.Length, 200)];
    ViewData["Image"] = $"/social/extension/{Model.Package.ID}.png";
    ViewData["ImageWidth"] = VsixGallery.SocialCardRenderer.Width;
    ViewData["ImageHeight"] = VsixGallery.SocialCardRenderer.Height;
    ViewData["TwitterCard"] = "summary_large_image";
    ViewData["FeedUrl"] = Model.Package.FeedLink;
    ViewData["FeedTitle"] = $"{Model.Package.Name} – extension feed";

    var request = ViewContext.HttpContext.Request;
    string baseUrl = $"{request.Scheme}://{request.Host}";
    var jsonLd = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "SoftwareApplication",
        ["name"] = Model.Package.Name ?? string.Empty,
        ["description"] = Model.Package.Description ?? string.Empty,
        ["image"] = baseUrl + Model.Package.Icon,
        ["url"] = baseUrl + Model.Package.DetailsLink,
        ["applicationCategory"] = "DeveloperApplication",
        ["operatingSystem"] = "Windows",
        ["softwareVersion"] = Model.Package.Version ?? string.Empty,
        ["datePublished"] = Model.Package.DatePublished.ToString("o"),
        ["author"] = new Dictionary<string, object>
        {
            ["@type"] = "Person",
            ["name"] = Model.Package.Author ?? string.Empty,
            ["url"] = baseUrl + Model.Package.AuthorLink,
        },
        ["downloadUrl"] = baseUrl + Model.Package.DownloadLink,
        ["offers"] = new Dictionary<string, object>
        {
            ["@type"] = "Offer",
            ["price"] = "0",
            ["priceCurrency"] = "USD",
        },
    };
    // schema.org license expects a URL, not the full license text.
    if (!string.IsNullOrWhiteSpace(Model.Package.License) &&
        Model.Package.License.StartsWith("http", StringComparison.OrdinalIgnoreCase))
    {
        jsonLd["license"] = Model.Package.License;
    }
    string jsonLdScript = JsonSerializer.Serialize(jsonLd, new JsonSerializerOptions { WriteIndented = false });

    // Register this inline script's SHA-256 with the CSP so the Content-Security-Policy header allows it.
    ViewContext.HttpContext.AddInlineScriptHash(jsonLdScript);
}

@section Styles {
    <link href="~/css/extensions.css" rel="stylesheet" />
}

<script type="application/ld+json">@Html.Raw(jsonLdScript)</script>

<article>
    <h1>
        @Model.Package.Name
        <a href="@Model.Package.FeedLink" class="feed shadow" title="ATOM feed for this extension only">Gallery feed (extension)</a>
    </h1>
    <img src="@Model.Package.Icon"
         class="icon"
         alt=""
         width="@(Model.Package.IconWidth > 0 ? Model.Package.IconWidth.ToString() : "90")"
         height="@(Model.Package.IconHeight > 0 ? Model.Package.IconHeight.ToString() : "90")"
         fetchpriority="high" />

    <div id="details">
        <p>@Model.Package.Description</p>
        <a class="download shadow" href="@Model.Package.DownloadLink" title="@Model.Package.FormattedFileSize">▼ Download</a>

        <dl>
            <dt>Author</dt>
            <dd><a href="@Model.Package.AuthorLink">@Model.Package.Author</a></dd>

            <dt>Version</dt>
            <dd>@Model.Package.Version</dd>

            <dt>Updated</dt>
            <dd title="@Model.Package.DatePublished.ToUniversalTime()">@Model.Package.TimeAgo()</dd>

            @if (!string.IsNullOrWhiteSpace(Model.Package.Tags))
            {
                <dt>Tags</dt>
                <dd>@Model.Package.Tags</dd>
            }

            @if (Model.Package.FriendlyTargets.Any())
            {
                <dt>Supports</dt>
                <dd>
                    @foreach (var target in Model.Package.FriendlyTargets)
                    {
                        <span class="version-badge">@target</span>
                    }
                </dd>
            }
        </dl>

        <ul id="links">
            @if (!string.IsNullOrWhiteSpace(Model.Package.MoreInfoUrl))
            {
                <li><a href="@Model.Package.MoreInfoUrl" rel="noopener noreferrer">✪ Website</a></li>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Package.Repo))
            {
                <li><a href="@Model.Package.Repo" rel="noopener noreferrer">✎ Source code</a></li>
                <li><a href="@Model.Package.IssueTracker" rel="noopener noreferrer">✓ Issue tracker</a></li>
            }

            <li>
                <button type="button"
                        class="copy-badge-btn"
                        data-extension-id="@Model.Package.ID"
                        data-extension-name="@Model.Package.Name"
                        aria-label="Copy Markdown badge to clipboard">
                    🏷 Copy badge
                </button>
            </li>
        </ul>
    </div>

    @if (Model.Package.HasValidatorErrors)
    {
        <div id="validation">
            <h2>Validation</h2>
            <ul>
                @foreach (var error in Model.Package!.Errors!)
                {
                    <li>@error</li>
                }
            </ul>

            <a href="https://gist.github.com/madskristensen/7310c0d61694e323f4deeb5a70f35fec">See guidelines</a>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Package.ReadmeUrl))
    {
        <p id="readme" data-url="@Model.Package.ReadmeUrl">Loading...</p>
        <script src="~/js/readme.js" defer></script>
    }
</article>

