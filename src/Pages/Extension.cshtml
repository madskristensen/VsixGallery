@page "{id?}"
@model ExtensionModel
@using System.Text.Json;
@using VsixGallery;
@inject VsixGallery.PublicUrl _publicUrl

@{
    ViewData["Title"] = $"{Model.Package!.Name} - Visual Studio extension";
    var _desc = Model.Package.Description ?? string.Empty;
    ViewData["Description"] = _desc[..Math.Min(_desc.Length, 160)];
    ViewData["CanonicalPath"] = Model.Package.DetailsLink;
    ViewData["Image"] = $"/social/extension/{Uri.EscapeDataString(Model.Package.ID ?? string.Empty)}.png";
    ViewData["ImageWidth"] = VsixGallery.SocialCardRenderer.Width;
    ViewData["ImageHeight"] = VsixGallery.SocialCardRenderer.Height;
    ViewData["TwitterCard"] = "summary_large_image";
    ViewData["FeedUrl"] = Model.Package.FeedLink;
    ViewData["FeedTitle"] = $"{Model.Package.Name} – extension feed";

    var request = ViewContext.HttpContext.Request;
    string baseUrl = _publicUrl.GetOrigin(request);
    string extensionUrl = baseUrl + Model.Package.DetailsLink;
    string authorUrl = baseUrl + Model.Package.AuthorLink;
    string softwareId = extensionUrl + "#software";
    var softwareApplication = new Dictionary<string, object>
    {
        ["@id"] = softwareId,
        ["@type"] = "SoftwareApplication",
        ["name"] = Model.Package.Name ?? string.Empty,
        ["description"] = Model.Package.Description ?? string.Empty,
        ["image"] = baseUrl + Model.Package.Icon,
        ["url"] = extensionUrl,
        ["applicationCategory"] = "DeveloperApplication",
        ["operatingSystem"] = "Windows",
        ["softwareVersion"] = Model.Package.Version ?? string.Empty,
        ["datePublished"] = Model.Package.DatePublished.ToString("o"),
        ["author"] = new Dictionary<string, object>
        {
            ["name"] = Model.Package.Author ?? string.Empty,
            ["url"] = authorUrl,
        },
        ["downloadUrl"] = baseUrl + Model.Package.DownloadLink,
        ["offers"] = new Dictionary<string, object>
        {
            ["@type"] = "Offer",
            ["price"] = "0",
            ["priceCurrency"] = "USD",
        },
    };
    // schema.org license expects a URL, not the full license text.
    if (!string.IsNullOrWhiteSpace(Model.Package.License) &&
        Model.Package.License.StartsWith("http", StringComparison.OrdinalIgnoreCase))
    {
        softwareApplication["license"] = Model.Package.License;
    }
    var breadcrumb = new Dictionary<string, object>
    {
        ["@type"] = "BreadcrumbList",
        ["itemListElement"] = new object[]
        {
            new Dictionary<string, object>
            {
                ["@type"] = "ListItem",
                ["position"] = 1,
                ["name"] = "Visual Studio extensions",
                ["item"] = baseUrl + "/",
            },
            new Dictionary<string, object>
            {
                ["@type"] = "ListItem",
                ["position"] = 2,
                ["name"] = Model.Package.Author ?? string.Empty,
                ["item"] = authorUrl,
            },
            new Dictionary<string, object>
            {
                ["@type"] = "ListItem",
                ["position"] = 3,
                ["name"] = Model.Package.Name ?? string.Empty,
                ["item"] = extensionUrl,
            },
        },
    };
    var webPage = new Dictionary<string, object>
    {
        ["@type"] = "WebPage",
        ["name"] = Model.Package.Name ?? string.Empty,
        ["url"] = extensionUrl,
        ["mainEntity"] = new Dictionary<string, object> { ["@id"] = softwareId },
        ["breadcrumb"] = breadcrumb,
    };
    var jsonLd = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@graph"] = new object[] { webPage, softwareApplication },
    };
    string jsonLdScript = JsonSerializer.Serialize(jsonLd, new JsonSerializerOptions { WriteIndented = false });

    // Register this inline script's SHA-256 with the CSP so the Content-Security-Policy header allows it.
    ViewContext.HttpContext.AddInlineScriptHash(jsonLdScript);
}

@section Styles {
    <link href="~/css/extensions.css" rel="stylesheet" asp-append-version="true" />
}

<script type="application/ld+json">@Html.Raw(jsonLdScript)</script>

<article>
    <h1>
        @Model.Package.Name
        <a href="@Model.Package.FeedLink" class="feed shadow" title="ATOM feed for this extension only">Gallery feed (extension)</a>
    </h1>
    <img src="@Model.Package.Icon"
         class="icon"
         alt=""
         width="@(Model.Package.IconWidth > 0 ? Model.Package.IconWidth.ToString() : "90")"
         height="@(Model.Package.IconHeight > 0 ? Model.Package.IconHeight.ToString() : "90")"
         fetchpriority="high" />

    <div id="details">
        <p>@Model.Package.Description</p>
        <a class="download shadow" href="@Model.Package.DownloadLink" title="@Model.Package.FormattedFileSize">▼ Download</a>

        <dl>
            <dt>Author</dt>
            <dd><a href="@Model.Package.AuthorLink">@Model.Package.Author</a></dd>

            <dt>Version</dt>
            <dd>@Model.Package.Version</dd>

            <dt>Updated</dt>
            <dd title="@Model.Package.DatePublished.ToUniversalTime()">@Model.Package.TimeAgo()</dd>

            @if (!string.IsNullOrWhiteSpace(Model.Package.Tags))
            {
                <dt>Tags</dt>
                <dd>@Model.Package.Tags</dd>
            }

            @if (Model.Package.FriendlyTargets.Any())
            {
                <dt>Supports</dt>
                <dd>
                    @foreach (var target in Model.Package.FriendlyTargets)
                    {
                        <span class="version-badge">@target</span>
                    }
                </dd>
            }

        </dl>

        <ul id="links">
            @if (!string.IsNullOrWhiteSpace(Model.Package.MoreInfoUrl))
            {
                <li><a href="@Model.Package.MoreInfoUrl" rel="noopener noreferrer">✪ Website</a></li>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Package.Repo))
            {
                <li><a href="@Model.Package.Repo" rel="noopener noreferrer">✎ Source code</a></li>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Package.IssueTracker))
            {
                <li><a href="@Model.Package.IssueTracker" rel="noopener noreferrer">✓ Issue tracker</a></li>
            }

            <li class="actions-menu-item">
                <details class="actions-menu">
                    <summary aria-label="More actions">⚙️ Actions</summary>
                    <ul class="actions-menu-list">
                        <li>
                            <button type="button"
                                    class="copy-badge-btn"
                                    data-extension-id="@Model.Package.ID"
                                    data-extension-name="@Model.Package.Name"
                                    data-badge-format="svg"
                                    aria-label="Copy Markdown badge (SVG) to clipboard">
                                📋 Copy badge (SVG)
                            </button>
                        </li>
                        <li>
                            <button type="button"
                                    class="copy-badge-btn"
                                    data-extension-id="@Model.Package.ID"
                                    data-extension-name="@Model.Package.Name"
                                    data-badge-format="png"
                                    aria-label="Copy Markdown badge (PNG) to clipboard">
                                📋 Copy badge (PNG)
                            </button>
                        </li>
                        <li><a href="@(Model.Package.DetailsLink)/manage">🔧 Manage</a></li>
                        <li>
                            <a href="https://github.com/madskristensen/VsixGallery/issues/new?template=extension-deletion-request.yml&amp;title=@Uri.EscapeDataString($"[delete] {Model.Package.ID}")&amp;extension-url=@Uri.EscapeDataString($"{baseUrl}{Model.Package.DetailsLink}")"
                               rel="noopener noreferrer"
                               title="Report this extension to the gallery admin">
                                🚩 Report
                            </a>
                        </li>
                    </ul>
                </details>
            </li>
        </ul>
    </div>

    @if (Model.Package.HasValidatorErrors)
    {
        <div id="validation">
            <h2>Validation</h2>
            <ul>
                @foreach (ValidationFinding finding in Model.Package.Validation)
                {
                    <li>@finding.Message</li>
                }
            </ul>

            <a href="/guidelines">See validation guidelines</a>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ReadmeHtml))
    {
        <section id="readme" aria-label="Extension README">
            @Html.Raw(Model.ReadmeHtml)
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(Model.Package.ReadmeUrl))
    {
        <p class="readme-unavailable">The extension README is temporarily unavailable.</p>
    }
</article>
