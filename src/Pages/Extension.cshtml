@page "{id?}"
@model ExtensionModel
@using moment.net;

@{
    ViewData["Title"] = Model.Package.Name;
    ViewData["Description"] = Model.Package.Description.Substring(0, Math.Min(Model.Package.Description.Length, 200));
    ViewData["Image"] = Model.Package.Icon;
}

<link href="~/css/extensions.css" rel="stylesheet" />

<article>
    <h1>
        @Model.Package.Name
        <a href="@Model.Package.FeedLink" class="feed shadow" title="ATOM feed for this extension only">Gallery feed (extension)</a>
    </h1>
    <img class="icon" src="@Model.Package.Icon" asp-append-version="true" alt="@Model.Package.Name" />

    <div id="details">
        <p>@Model.Package.Description</p>
        <a class="download shadow" href="@Model.Package.DownloadLink" title="@Model.Package.FormattedFileSize">▼ Download</a>

        <dl>
            <dt>Author</dt>
            <dd><a href="@Model.Package.AuthorLink">@Model.Package.Author</a></dd>

            <dt>Version</dt>
            <dd>@Model.Package.Version</dd>

            <dt>Updated</dt>
            <dd title="@Model.Package.DatePublished.ToUniversalTime()">@Model.Package.DatePublished.FromNow()</dd>

            @if (!string.IsNullOrWhiteSpace(Model.Package.Tags))
            {
                <dt>Tags</dt>
                <dd>@Model.Package.Tags</dd>
            }

            @if (Model.Package.FriendlyTargets.Any())
            {
                <dt>Supports</dt>
                <dd>
                    @foreach (var target in Model.Package.FriendlyTargets)
                    {
                        <span class="version-badge">@target</span>
                    }
                </dd>
            }
        </dl>

        <ul id="links">
            <li><a href="@Model.Package.MoreInfoUrl" rel="noopener noreferrer">✪ Website</a></li>

            @if (!string.IsNullOrWhiteSpace(Model.Package.Repo))
            {
                <li><a href="@Model.Package.Repo" rel="noopener noreferrer">✎ Source code</a></li>
                <li><a href="@Model.Package.IssueTracker" rel="noopener noreferrer">✓ Issue tracker</a></li>
            }
        </ul>
    </div>

    @if (Model.Package.HasValidatorErrors)
    {
        <div id="validation">
            <h2>Validation</h2>
            <ul>
                @foreach (var error in Model.Package.Errors)
                {
                    <li>@error</li>
                }
            </ul>

            <a href="https://gist.github.com/madskristensen/7310c0d61694e323f4deeb5a70f35fec">See guidelines</a>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Package.ReadmeUrl))
    {
        <p id="readme">Loading...</p>
        <script>
            var readme = document.getElementById('readme');
            var url = '@Model.Package.ReadmeUrl';

            function fetchReadme(readmeUrl) {
                return fetch('https://markdownservice.azurewebsites.net/markdown.ashx?url=' + readmeUrl)
                    .then(response => response.text());
            }

            function getAlternateUrl(readmeUrl) {
                // Try swapping main <-> master in the branch segment
                if (readmeUrl.includes('/refs/heads/main/')) {
                    return readmeUrl.replace('/refs/heads/main/', '/refs/heads/master/');
                }
                if (readmeUrl.includes('/refs/heads/master/')) {
                    return readmeUrl.replace('/refs/heads/master/', '/refs/heads/main/');
                }
                // Legacy URLs without /refs/heads/
                if (readmeUrl.includes('/main/')) {
                    return readmeUrl.replace('/main/', '/master/');
                }
                if (readmeUrl.includes('/master/')) {
                    return readmeUrl.replace('/master/', '/main/');
                }
                return null;
            }

            fetchReadme(url).then(text => {
                if (text && text.trim().length > 0 && !text.includes('404')) {
                    readme.innerHTML = text;
                } else {
                    var alt = getAlternateUrl(url);
                    if (alt) {
                        fetchReadme(alt).then(t => readme.innerHTML = t);
                    } else {
                        readme.innerHTML = text;
                    }
                }
            });
        </script>
    }
</article>
