@page
@model IndexModel
@using System.Text.Json
@inject VsixGallery.PublicUrl _publicUrl
@{
    ViewData["Title"] = Model.CurrentPage > 1
        ? $"Visual Studio extensions - Page {Model.CurrentPage}"
        : ViewData["SiteName"];
    ViewData["Description"] = Model.CurrentPage > 1
        ? $"Browse page {Model.CurrentPage} of Visual Studio extensions, including nightly builds and extensions not available on the official Marketplace."
        : "Browse Visual Studio extensions, nightly builds, and independent releases not available on the official Marketplace.";
    ViewData["FeedUrl"] = "/feed/";
    ViewData["FeedTitle"] = $"{ViewData["SiteName"]} – all extensions";
    ViewData["CanonicalPath"] = Model.CurrentPage > 1 ? $"/?page={Model.CurrentPage}" : "/";

    var request = ViewContext.HttpContext.Request;
    string baseUrl = _publicUrl.GetOrigin(request);
    var webSite = new Dictionary<string, object>
    {
        ["@type"] = "WebSite",
        ["name"] = ViewData["SiteName"] ?? string.Empty,
        ["url"] = baseUrl + "/",
        ["potentialAction"] = new Dictionary<string, object>
        {
            ["@type"] = "SearchAction",
            ["target"] = new Dictionary<string, object>
            {
                ["@type"] = "EntryPoint",
                ["urlTemplate"] = baseUrl + "/search?q={search_term_string}",
            },
            ["query-input"] = "required name=search_term_string",
        },
    };
    var itemList = new Dictionary<string, object>
    {
        ["@type"] = "ItemList",
        ["name"] = $"Visual Studio extensions - Page {Model.CurrentPage}",
        ["itemListElement"] = Model.Packages.Select((package, index) => new Dictionary<string, object>
        {
            ["@type"] = "ListItem",
            ["position"] = index + 1,
            ["name"] = package.Name ?? string.Empty,
            ["url"] = baseUrl + package.DetailsLink,
        }).ToArray(),
    };
    var jsonLd = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@graph"] = new object[] { webSite, itemList },
    };
    string jsonLdScript = JsonSerializer.Serialize(jsonLd, new JsonSerializerOptions { WriteIndented = false });
    ViewContext.HttpContext.AddInlineScriptHash(jsonLdScript);
}

<script type="application/ld+json">@Html.Raw(jsonLdScript)</script>

<section class="home-hero" aria-labelledby="hero-title">
    <button type="button" class="dismiss-hero" aria-label="Dismiss introduction" title="Dismiss introduction">&times;</button>
    <p class="eyebrow">Community extension gallery</p>
    <h1 id="hero-title">Visual Studio extensions beyond the Marketplace</h1>
    <p>
        Discover nightly builds and independently published extensions, or connect the gallery feed
        to receive updates in Visual Studio. Packages are supplied directly by their publishers.
    </p>
</section>

<div class="section-heading" id="extensions">
    <h2>All extensions</h2>
    <a href="~/feed/" class="feed shadow" title="ATOM feed for all extensions">Gallery feed</a>
</div>

@await Html.PartialAsync("_ExtensionList", Model.Packages)

@await Html.PartialAsync("_Pagination", new PaginationModel
{
    CurrentPage = Model.CurrentPage,
    TotalPages = Model.Pages,
    Path = "/",
    Fragment = "extensions",
})