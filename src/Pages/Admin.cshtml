@page "/admin"
@model VsixGallery.Pages.AdminModel
@{
    ViewData["Title"] = "Admin";
    ViewData["HideUploadGuideLink"] = true;
    ViewData["HideSetupLink"] = true;
    ViewData["HideCreateExtensionLink"] = true;
}

<article class="admin-page">
    <h1>Admin &mdash; trash bin</h1>

    @if (!Model.IsConfigured)
    {
        <section class="admin-alert">
            <h2>Admin password not configured</h2>
            <p>
                Set the <code>Admin:Password</code> configuration value (e.g. via
                <code>appsettings.json</code> or an environment variable) to enable
                this page.
            </p>
        </section>
    }
    else if (!Model.IsAuthenticated)
    {
        <section class="admin-signin">
            <h2>Sign in</h2>
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <p class="admin-alert" role="alert"><strong>@Model.ErrorMessage</strong></p>
            }
            <form method="post" asp-page-handler="SignIn">
                <label for="password">Admin password</label>
                <input type="password" id="password" name="Password" autocomplete="current-password" required />
                <button type="submit">Sign in</button>
            </form>
        </section>
    }
    else
    {
        <p>
            Soft-deleted extensions are retained for
            <strong>@Model.RetentionDays day(s)</strong> before being permanently purged.
        </p>

        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <p class="admin-status" role="status"><strong>@Model.StatusMessage</strong></p>
        }

        @if (Model.Trash.Count == 0)
        {
            <p class="admin-empty"><em>The trash bin is empty.</em></p>
        }
        else
        {
            <table class="admin-table">
                <thead>
                    <tr>
                        <th scope="col">Extension</th>
                        <th scope="col">Author</th>
                        <th scope="col">Deleted</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var entry in Model.Trash)
                {
                    <tr>
                        <td data-label="Extension">
                            <span class="ext-name">@(entry.Package.Name ?? entry.Package.ID)</span>
                            <code>@entry.Package.ID</code>
                        </td>
                        <td data-label="Author">@entry.Package.Author</td>
                        <td data-label="Deleted">
                            @(entry.DeletedAt.HasValue
                                ? entry.DeletedAt.Value.ToString("u")
                                : "unknown")
                        </td>
                        <td data-label="Actions" class="actions">
                            <div class="admin-actions">
                                <form method="post" asp-page-handler="Restore">
                                    <input type="hidden" name="TrashFolder" value="@entry.TrashFolder" />
                                    <button type="submit">Restore</button>
                                </form>
                                <form method="post" asp-page-handler="HardDelete">
                                    <input type="hidden" name="TrashFolder" value="@entry.TrashFolder" />
                                    <button type="submit" class="btn-danger" data-confirm="Permanently delete this extension?">Delete forever</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }

        <form class="admin-signout" method="post" asp-page-handler="SignOut">
            <button type="submit" class="btn-secondary">Sign out</button>
        </form>
    }
</article>
