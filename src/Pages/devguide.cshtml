@page
@{
    ViewData["Title"] = "Add your extension";
    ViewData["Description"] = "Publish a Visual Studio extension to Open VSIX Gallery manually or from GitHub Actions, PowerShell, curl, or AppVeyor.";
    ViewData["CanonicalPath"] = "/devguide";
    ViewData["ContentClass"] = "guide-page";
