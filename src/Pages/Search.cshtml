@page
@model SearchModel

@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Term)
        ? "Search extensions"
        : $"Search results for '{Model.Term}'";
    ViewData["Description"] = string.IsNullOrWhiteSpace(Model.Term)
        ? "Search for Visual Studio extensions in this alternative VSIX gallery."
        : $"Found {Model.TotalResults} Visual Studio extensions matching '{Model.Term}'.";
    ViewData["Robots"] = "noindex, follow";
    ViewData["SuppressCanonical"] = true;
}

@if (string.IsNullOrWhiteSpace(Model.Term))
{
    <h1>Search extensions</h1>
}
else
{
    <h1>@Model.TotalResults @(Model.TotalResults == 1 ? "result" : "results") for <em>@Model.Term</em></h1>

    @if (Model.TotalResults == 0)
    {
        <section class="empty-state" aria-labelledby="no-results-title">
            <h2 id="no-results-title">No extensions found</h2>
            <p>Check the spelling, try fewer or broader words, or browse all available extensions.</p>
            <a class="button-link" href="/">Browse all extensions</a>
        </section>
    }
    else
    {
        <p class="search-summary">
            Results are ordered by relevance.
            <a href="/search/">Clear search</a>
        </p>
        @await Html.PartialAsync("_ExtensionList", Model.Packages)
        @await Html.PartialAsync("_Pagination", new PaginationModel
        {
            CurrentPage = Model.CurrentPage,
            TotalPages = Model.Pages,
            Path = "/search/",
            SearchTerm = Model.Term,
        })
    }
}